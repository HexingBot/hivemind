# hivemind — environment variable template
#
# Copy to `.env` (gitignored) and fill in real values, then export before
# launching Claude Code:
#
#   set -a; source .env; set +a
#   claude
#
# The committed `.claude/settings.json` references these by name via
# ${VAR} interpolation, which resolves from the host environment at launch.
# Never commit real values — `.env` and `.env.*` are gitignored.

# --- GitHub MCP server (@modelcontextprotocol/server-github) ---
# Fine-grained PAT scoped to the hivemind repo; needs `repo`
# (and `read:org` only if accessing org-level resources).
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Atlassian MCP server (@atlassian/mcp-server-atlassian) ---
ATLASSIAN_SITE_URL=
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=
