# Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/
# Exception: session-bundle lifecycle logs ARE structural state (audit trail of
# migrate_v1/pause/resume/end events) and must travel with the bundle for
# cross-machine portability per TASK-004 design.
!state/sessions/**/lifecycle.log
# Counter-example to the exception above: the TASK-219 SubagentStop log is
# runtime TELEMETRY, not handoff state — it is append-only, grows per subagent
# turn, and nothing in the resume contract reads it. It does not match *.log
# (it is .jsonl), so it needs its own entry.
state/sessions/**/subagent-log.jsonl

# Language runtimes (added defensively; uncomment as stacks land)
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# NOTE (TASK-023): dist/ is NOT ignored — it holds the COMMITTED esbuild plugin
# bundles (dist/*.cjs) that are the plugin's shipped entrypoints. A git-URL
# plugin install ships no node_modules, so the self-contained bundles must
# travel in the repo. Regenerate them with `npm run build:plugin`.
build/

# Local-only Claude Code settings overrides (per-machine)
.claude/settings.local.json

# Runtime-only artifacts (TASK-083) — the advisory session lock and orphan
# atomic-write tmp siblings (src/atomic-write.js's `${base}.tmp.${pid}-${hex}`
# naming). Scoped globs so tracked bundle/task files alongside them are unaffected.
state/.lock
state/**/*.tmp.*
tasks/*.tmp.*
# TASK-235 (WG2-235 second wargaming pass, LOW) — the tasks mutation lock
# (tasks/.mutate.lock, src/task-store.js's acquireTasksLock) and its
# acquisition-time quarantine copies (tasks/.mutate.lock.stale.<token>) are
# the same class of runtime-only, per-process lock artifact as state/.lock
# above — a live lock file showing up in `git status`/`git add tasks/` would
# commit a live process's advisory lock into the repo.
tasks/.mutate.lock
tasks/.mutate.lock.stale.*
.firebase/
