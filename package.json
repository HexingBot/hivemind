{
  "name": "hivemind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent software-engineering harness built on the Claude Agent SDK.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run --config vitest.config.all.js",
    "test:changed": "vitest run --changed --config vitest.config.all.js",
    "test:since": "node scripts/test-since.mjs",
    "test:e2e": "vitest run --config vitest.config.all.js tests/e2e",
    "test:use-cases": "vitest run --config vitest.config.all.js tests/use-cases tests/use-case-policy.spec.js --passWithNoTests",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:calibration": "node bin/check-calibration.js",
    "check:manifests": "node scripts/verify-manifests.mjs",
    "bootstrap:brain": "node dist/brain-launch.cjs --health",
    "e2e:brain": "bash scripts/brain-smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "gray-matter": "^4.0.3",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.2"
  }
}
